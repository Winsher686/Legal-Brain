# ============================================================
# Legal Brain（企业法务智库）环境变量模板
# 使用方法：复制本文件为 knowledge/.env，然后填入真实值。
#   cp knowledge/.env.example knowledge/.env
# 注意：knowledge/.env 已被 .gitignore 忽略，切勿提交真实密钥。
# ============================================================

# ==================== LLM 配置（通义千问 DashScope）====================
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
# 默认对话/生成模型（代码读 MODEL；LLM_DEFAULT_MODEL 为兼容旧版的别名）
MODEL=qwen-plus
LLM_DEFAULT_TEMPERATURE=0.1
# 法规名/合同类型识别专用模型
ITEM_MODEL=qwen-flash
# 知识图谱抽取模型
KG_MODEL=qwen-plus
# 视觉多模态模型（图片总结）
VL_MODEL=qwen3-vl-flash

# ==================== 向量与重排序模型（BGE 系列）====================
# 本地权重目录；留空则使用下方模型名在线加载
BGE_M3_PATH=
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
BGE_RERANKER_LARGE=BAAI/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False
# 法规名识别链路的向量模型（可选）
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# ==================== Milvus 向量数据库 ====================
MILVUS_URL=http://localhost:19530
# 文档切片集合
CHUNKS_COLLECTION=chunks
# 法规名/合同类型集合（原 item_name 集合）
ITEM_NAME_COLLECTION=item_names
# 实体名集合
ENTITY_NAME_COLLECTION=entity_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.5

# ==================== Neo4j 图数据库 ====================
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ==================== MongoDB 文档/历史数据库 ====================
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=legal_brain

# ==================== MinIO 对象存储 ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=legal-brain

# ==================== MCP 网络搜索 ====================
MCP_DASHSCOPE_BASE_URL=

# ==================== 检索/排序参数（可选，含默认值）====================
MAX_CONTEXT_CHARS=12000
RERANK_MAX_TOP_K=10
RERANK_MIN_TOP_K=3
RERANK_GAP_RATIO=0.25
RERANK_GAP_ABS=0.5
RRF_K=60
RRF_KG_WEIGHT=0.7
RRF_MAX_RESULTS=10
EMBEDDING_SEARCH_LIMIT=10
HYDE_SEARCH_LIMIT=5
ITEM_NAME_HIGH_CONFIDENCE=0.7
ITEM_NAME_MID_CONFIDENCE=0.6
ITEM_NAME_MAX_OPTIONS=5
ITEM_NAME_DENSE_WEIGHT=0.5
ITEM_NAME_SPARSE_WEIGHT=0.5
ITEM_NAME_DIAG=False
KG_ENTITY_ALIGN_MIN_SCORE=0.5
KG_MAX_SEED_CANDIDATES=3
KG_MAX_TOTAL_SEEDS=30
KG_MAX_TRIPLES_PER_SEED=50
KG_MAX_TOTAL_TRIPLES=50
KG_MAX_TOTAL_CHUNKS=50
